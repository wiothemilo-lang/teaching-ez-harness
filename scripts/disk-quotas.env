# Hạn mức dung lượng (soft/hard). Sửa ở đây, không sửa trong script.
# Đơn vị: K, M, G, T. Không dùng khoảng trắng.

QUOTA_RUSTUP=2G
QUOTA_RUSTUP_HARD=3G

QUOTA_CARGO_REGISTRY=3G
QUOTA_CARGO_REGISTRY_HARD=4G

QUOTA_CARGO_GIT=1G
QUOTA_CARGO_GIT_HARD=2G

QUOTA_TARGET=8G
QUOTA_TARGET_HARD=12G

QUOTA_DESKTOP_TARGET=7G
QUOTA_DESKTOP_TARGET_HARD=9G

# Tổng Rust build = rustup + cargo registry + cargo git + target/ + desktop target/.
# Vượt mềm: xóa incremental + cache cũ. Vượt cứng: cargo clean cả hai target.
QUOTA_RUST_BUILD=24G
QUOTA_RUST_BUILD_HARD=30G

QUOTA_FNM=1G
QUOTA_FNM_HARD=2G

QUOTA_PNPM_STORE=3G
QUOTA_PNPM_STORE_HARD=5G

QUOTA_NODE_MODULES=2G
QUOTA_NODE_MODULES_HARD=3G

QUOTA_APP_DATA=5G
QUOTA_APP_DATA_HARD=8G

QUOTA_LOGS=200M
QUOTA_LOGS_HARD=500M

QUOTA_OLLAMA=15G
QUOTA_OLLAMA_HARD=20G

QUOTA_TOTAL_SOFT=30G
QUOTA_TOTAL_HARD=40G

# Số ngày giữ lại khi dọn dẹp
RETENTION_CARGO_DAYS=30
RETENTION_LOG_DAYS=7
RETENTION_SESSION_DAYS=90
RETENTION_CONTEXT_DAYS=30
