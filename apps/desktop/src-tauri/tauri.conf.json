{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tez",
  "version": "0.1.0",
  "identifier": "dev.teaching-ez.tez",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tez — Gia sư AI",
        "width": 1120,
        "height": 780,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Gia sư AI local-first cho học sinh",
    "longDescription": "tez là gia sư AI chạy trên máy bạn: dạy Toán, Vật lý, Hóa học, Tiếng Anh theo từng bước, dùng tool để tính toán và kiểm tra, lưu dữ liệu local.",
    "category": "Education"
  }
}
