{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tez",
  "version": "0.1.0",
  "identifier": "dev.teaching-ez.tez",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tez — Chat & Code",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#131211"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Chat và code agent local-first",
    "longDescription": "tez là workspace AI local-first: một phần Chat tổng quát không giới hạn môn học, một phần Code đọc/sửa file và chạy lệnh trong workspace. Dữ liệu và API key nằm trên máy bạn.",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"]
      }
    }
  }
}
